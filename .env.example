POSTGRES_DB=tenderscope
POSTGRES_USER=tenderscope
POSTGRES_PASSWORD=tenderscope
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=tenderscope;Username=tenderscope;Password=tenderscope
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=TenderScope
Jwt__Audience=TenderScope.Web
Jwt__AllowHttp=true
Cors__AllowedOrigins__0=http://localhost:3000
ADMIN_API_KEY=replace-with-a-random-admin-key
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
